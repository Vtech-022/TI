{
  "name": "avant",
  "version": "1.0.0",
  "private": true,
  "description": "AVANT — Central Inteligente de Gestão",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "build:artifact": "vite build -c vite.artifact.config.ts && node scripts/build-artifact.mjs",
    "build:netlify": "vite build -c vite.netlify.config.ts",
    "netlify:local": "node scripts/netlify-local.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "@netlify/blobs": "^10.7.13",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.13.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
