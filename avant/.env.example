# Porta HTTP da API (e da aplicação compilada)
AVANT_PORT=4310
# Endereço de escuta. Mantenha 127.0.0.1 para uso local; não exponha publicamente sem autenticação.
AVANT_HOST=127.0.0.1
# Diretório de dados (banco SQLite e arquivos importados)
AVANT_DATA_DIR=./data
# Fuso horário de referência para datas e agenda
AVANT_TIMEZONE=America/Sao_Paulo
# Tamanho máximo de arquivo importado (MB)
AVANT_MAX_UPLOAD_MB=15
